# Copy to .env next to compose.yaml.

# Library on the host, mounted read-only into the container.
PHOTOS_DIR=/srv/photos/gallery

# Previews, transcoded videos and the SQLite index. Prefer an SSD
# (about 2 MB per photo); create it owned by PUID:PGID.
CACHE_DIR=./cache

# Owner of CACHE_DIR on the host (`id -u`, `id -g`); must be able to read PHOTOS_DIR.
PUID=1000
PGID=1000

# Full gallery, no login. 8080: LAN and tailnet. <tailnet IP>:8080: tailnet
# only. 127.0.0.1:8080: this machine only (a laptop).
PRIVATE_PORT=8080
# Share links; always published on the host's loopback (compose.yaml).
PUBLIC_PORT=8081

# Optional: your own config instead of the bundled docker/pellicule.toml,
# e.g. a copy of pellicule.example.toml.
# PELLICULE_TOML=./pellicule.docker.toml

RUST_LOG=pellicule=info

# Time zone for scan times on the Library page.
TZ=Europe/Paris
