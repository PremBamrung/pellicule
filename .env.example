# Copy to .env next to compose.yaml.

# Library on the host, mounted read-only into the container.
PHOTOS_DIR=/srv/photos/gallery

# Previews, transcoded videos and the SQLite index. Prefer an SSD.
CACHE_DIR=./cache

# Owner of CACHE_DIR on the host (`id -u`, `id -g`); must be able to read PHOTOS_DIR.
PUID=1000
PGID=1000

PRIVATE_PORT=8080
PUBLIC_PORT=8081

RUST_LOG=pellicule=info
